rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(data) { return isSignedIn() && data.userId == request.auth.uid; }
    
    // User Profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && userId == request.auth.uid;
      allow update: if isSignedIn() && userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'active', 'permissions', 'role']);
    }

    // Generic Multi-tenant Rule Helper
    function isTenantOwner() {
      return isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Secure List Queries
    // Every collection MUST check resource.data.userId against request.auth.uid for listing
    
    // Inventory & Products
    match /products/{productId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(productId);
      allow update, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /productMovements/{movementId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(movementId);
    }

    // Transactions
    match /sales/{saleId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(saleId);
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'notes']);
    }

    match /budgets/{budgetId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(budgetId);
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /serviceOrders/{osId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(osId);
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Customers & Bikes
    match /customers/{customerId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || incoming().userId == null); // Fallback for some legacy calls
      allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || existing().userId == null);
    }

    match /bikes/{bikeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Financial
    match /financialEntries/{entryId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /cashSessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /cashMovements/{movementId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
    }

    // Settings & Logs
    match /settings/{settingId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || settingId == 'global');
      allow write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /logs/{logId} {
      allow read, create: if isSignedIn() && (incoming().userId == request.auth.uid || existing().userId == request.auth.uid);
    }

    // Connection Test
    match /_connection_test_/{docId} {
      allow read: if true;
    }
  }
}
